{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/supabase/:path*", "destination": "https://ojwshgpvijmbcjyiggxl.supabase.co/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/help-single-mom-fight-stage-4-cancer", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin-login.html" },
    { "source": "/dashboard", "destination": "/admin.html" },
    { "source": "/dashboard/campanha", "destination": "/admin-campaign.html" },
    { "source": "/dashboard/doacoes", "destination": "/admin-donations.html" },
    { "source": "/dashboard/conteudo", "destination": "/admin-content.html" },
    { "source": "/dashboard/gateway", "destination": "/admin-gateway.html" },
    { "source": "/checkout", "destination": "/checkout.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
